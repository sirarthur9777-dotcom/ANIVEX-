rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true;
    }

    // Public CMS content: everyone may read, only registered CMS admins may write.
    match /websiteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /companyInfo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /paymentSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /socialLinks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /builtByAnivex/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /solutions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /media/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public enquiry submission. Reading and moderation are admin-only.
    match /contactEnquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin-only data.
    match /notifications/{docId} {
      allow read, write: if isAdmin();
    }
    match /activityLogs/{docId} {
      allow read, write: if isAdmin();
    }
    match /invoices/{docId} {
      allow read, write: if isAdmin();
    }
    match /clients/{docId} {
      allow read, write: if isAdmin();
    }
    match /contracts/{docId} {
      allow read, write: if isAdmin();
    }
    match /quotations/{docId} {
      allow read, write: if isAdmin();
    }

    // Admin identity records are provisioned manually in Firebase Console.
    // A signed-in user may read only their own authorization record.
    match /adminUsers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Explicitly deny unknown collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
