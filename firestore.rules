rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isBootstrappedAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'sirarthur9777@gmail.com'
            || request.auth.token.email == 'kdsingh9777@gmail.com');
    }

    function isAdmin() {
      return request.auth != null
        && (
          isBootstrappedAdmin()
          || (
            exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
            && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'admin'
            && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true
          )
        );
    }

    // Public CMS content: everyone may read, only registered CMS admins may write.
    match /websiteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /companyInfo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /paymentSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /socialLinks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /builtByAnivex/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /solutions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /media/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public enquiry submission. Reading and moderation are admin-only.
    // The create rule validates the shape/size of public input to reduce abuse;
    // it does not replace application-level anti-spam/rate limiting.
    function validPublicEnquiry() {
      return request.resource.data.keys().hasAll([
          'id', 'fullName', 'email', 'phone', 'company', 'projectType',
          'budgetRange', 'description', 'date', 'time', 'submittedAt',
          'status', 'read'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'fullName', 'email', 'phone', 'company', 'projectType',
          'budgetRange', 'description', 'date', 'time', 'submittedAt',
          'status', 'read'
        ])
        && request.resource.data.id == docId
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 160
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 160
        && request.resource.data.projectType is string
        && request.resource.data.projectType.size() <= 120
        && request.resource.data.budgetRange is string
        && request.resource.data.budgetRange.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5
        && request.resource.data.description.size() <= 5000
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.submittedAt is string
        && request.resource.data.status == 'New'
        && request.resource.data.read == false;
    }

    match /contactEnquiries/{docId} {
      allow create: if validPublicEnquiry();
      allow read, update, delete: if isAdmin();
    }

    // Admin-only data.
    match /notifications/{docId} {
      allow read, write: if isAdmin();
    }
    match /activityLogs/{docId} {
      allow read, write: if isAdmin();
    }
    match /invoices/{docId} {
      allow read, write: if isAdmin();
    }
    match /clients/{docId} {
      allow read, write: if isAdmin();
    }
    match /contracts/{docId} {
      allow read, write: if isAdmin();
    }
    match /quotations/{docId} {
      allow read, write: if isAdmin();
    }

    // Admin identity records are provisioned in Firebase Console or managed by active admins.
    // A signed-in user may read their own authorization record.
    match /adminUsers/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Explicitly deny unknown collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
